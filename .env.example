# Server-only LensPilot creative API configuration.
OPENAI_API_KEY=
LENSPILOT_OPENAI_MODEL=gpt-5.6-luna
LENSPILOT_OPENAI_WEB_SEARCH=true

# Optional LensPilot API client authorization, not an OpenAI key.
LENSPILOT_CREATIVE_API_TOKEN=

# iOS development configuration.
LENSPILOT_CREATIVE_API_URL=https://api.example.com/v1/creative-interpretation
LENSPILOT_ALLOW_DIRECT_OPENAI_PROVIDER=false
